{
  "name": "mustafa-dandan-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:admin": "concurrently -k \"npm:server\" \"npm:dev:admin\"",
    "build": "ng build && node scripts/prepare-static-routes.mjs",
    "deploy": "npm run build && ng deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:angular": "ng serve",
    "dev:admin": "ng serve --proxy-config proxy.conf.json",
    "server": "node server/server.mjs",
    "schema:generate": "node scripts/generate-schema.mjs",
    "check:server": "node --check server/server.mjs",
    "test:admin": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.22",
    "@angular/cli": "^19.2.22",
    "@angular/compiler-cli": "^19.2.0",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^3.1.0",
    "concurrently": "^9.2.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  },
  "description": "Portfolio site for Mustafa Dandan — Civil Engineer, VDC & BIM Designer."
}
